{
  "name": "devpilot/api",
  "type": "project",
  "description": "DevPilot Phase 1 API foundation.",
  "keywords": ["laravel", "api"],
  "license": "MIT",
  "require": {
    "php": "^8.2",
    "ext-pdo": "*",
    "ext-pdo_pgsql": "*",
    "laravel/framework": "^12.0"
  },
  "require-dev": {
    "laravel/pint": "^1.18",
    "phpunit/phpunit": "^11.5"
  },
  "autoload": {
    "psr-4": {
      "App\\": "app/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "@php artisan test",
    "format": "pint",
    "format:check": "pint --test"
  },
  "config": {
    "optimize-autoloader": true,
    "preferred-install": "dist",
    "sort-packages": true
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
